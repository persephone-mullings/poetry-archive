---
import { getCollection, render } from "astro:content";
import PoemLayout from "../../layouts/PoemLayout.astro";

export async function getStaticPaths() {
  const poems = await getCollection("poems", ({ data }) => data.published);

  return poems.map((poem) => ({
    params: { id: poem.id },
    props: { poem },
  }));
}

const { poem } = Astro.props;
const { Content } = await render(poem);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(date);
---

<PoemLayout pageTitle={poem.data.title} description={`Poem: ${poem.data.title}`}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/poems/">← Poems</a>
  </nav>

  <article aria-labelledby="poem-title">
    <header class="poem-header">
      <h1 id="poem-title">{poem.data.title}</h1>
      <p class="poem-date">
        <time datetime={poem.data.date.toISOString()}>{formatDate(poem.data.date)}</time>
      </p>
    </header>

    <div class="poem-body">
      <Content />
    </div>
  </article>
</PoemLayout>
