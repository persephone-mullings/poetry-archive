---
import "../styles/global.css";

const {
  pageTitle = "Persephone's Poems",
  description = "A collection of poems.",
  contentClass = "",
} = Astro.props;

const fullTitle = pageTitle === "Persephone's Poems" ? pageTitle : `${pageTitle} | Persephone's Poems`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <nav class="top-nav" aria-label="Main navigation">
          <a href="/" class="brand">Persephone's Poems</a>
          <a href="/poems/">Poems</a>
        </nav>
      </header>

      <main class:list={["page-content", contentClass]}>
        <slot />
      </main>

      <footer class="site-footer">
        <p>Persephone's Poems</p>
      </footer>
    </div>
  </body>
</html>
